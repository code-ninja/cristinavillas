---
import Base from '../../layouts/Base.astro'
import Hero from '../../components/Hero.astro'
import PackagesSection from '../../components/PackagesSection.astro'
import { getPackageBySlug, getSiteChrome, StrapiError } from '../../lib/strapi'
import { getSetting } from '../../lib/settings'
import { mediaUrl } from '../../lib/env'
import { renderMarkdown } from '../../lib/markdown'

const { slug } = Astro.params
if (!slug) return Astro.rewrite('/404')

let pkg
let packages
let headerLogo = ''
try {
  pkg = await getPackageBySlug(slug)
  const chrome = await getSiteChrome()
  packages = chrome.packages
  headerLogo = getSetting(chrome.settings, 'headerLogo')
} catch (e) {
  if (e instanceof StrapiError) return Astro.redirect('/502')
  throw e
}
if (!pkg) return Astro.rewrite('/404')

const html = await renderMarkdown(pkg.description)
---

<Base
  title={pkg.name}
  description={pkg.name}
  path={`/packages/${slug}`}
  ogImage={mediaUrl(pkg.img.url)}
  ogImageAlt={pkg.name}
>
  <Hero title={pkg.name} img={pkg.img.url} headerLogoHtml={headerLogo} />
  <section>
    <div class="container">
      <div class="row justify-content-md-center">
        <div class="col-md-10 col-lg-6 text-center">
          <h2 class="title">{pkg.name}</h2>
          <hr /><br />
        </div>
      </div>
      <div class="row justify-content-center">
        <div class="col-8 marked" set:html={html} />
      </div>
    </div>
  </section>
  <PackagesSection packages={packages} subtitle="View the other packages that we offer" />
</Base>
